# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/bonjou?schema=public"

# Server
PORT=3000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# WhatsApp Cloud API
# Set WHATSAPP_ENABLED=false for local demo without Meta credentials.
WHATSAPP_ENABLED=false
WHATSAPP_VERIFY_TOKEN=change-me-local-verify-token
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_VERSION=v21.0

# Translation
# mock works immediately and does not require paid runtime AI.
# claude uses Claude Haiku (low cost, good Haitian Creole coverage). Requires ANTHROPIC_API_KEY.
# openai uses gpt-4.1-mini. Requires OPENAI_API_KEY.
TRANSLATION_PROVIDER=mock
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Demo data
# Keep false for normal Docker demo startup. Set true only when you want the sample seed ticket.
SEED_DEMO_DATA=false

# Bonjou demo password. Leave empty for local demo. Set in production.
DASHBOARD_ACCESS_TOKEN=
