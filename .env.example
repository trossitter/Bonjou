# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/bonjou?schema=public"

# Server
PORT=3000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# WhatsApp Cloud API
# Set WHATSAPP_ENABLED=false for local demo without Meta credentials.
WHATSAPP_ENABLED=false
WHATSAPP_VERIFY_TOKEN=change-me-local-verify-token
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_VERSION=v21.0

# Translation
# mock works immediately. openai works if OPENAI_API_KEY is set.
TRANSLATION_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Demo auth gate. Leave empty for local demo. Set in production.
DASHBOARD_ACCESS_TOKEN=
