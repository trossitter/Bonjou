NODE_ENV=production
PORT=3000

# Compose Postgres settings. Change POSTGRES_PASSWORD before starting production.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_DB_PASSWORD
POSTGRES_DB=bonjou
DATABASE_URL=postgresql://postgres:CHANGE_ME_DB_PASSWORD@db:5432/bonjou?schema=public

# Demo mode is the default. No Meta credentials are required.
WHATSAPP_ENABLED=false
WHATSAPP_VERIFY_TOKEN=CHANGE_ME_RANDOM_STRING
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_VERSION=v21.0

# claude uses Claude Haiku — recommended for production (low cost, good Haitian Creole).
# mock is free and works offline. Use mock only if you have no API key.
TRANSLATION_PROVIDER=claude
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
OPENAI_API_KEY=
OPENAI_MODEL=

# Keep false in production unless you intentionally want the sample ticket.
SEED_DEMO_DATA=false

# Shared Bonjou demo password for the dashboard, ticket APIs, and /dev/simulate-inbound.
DASHBOARD_ACCESS_TOKEN=CHANGE_ME_RANDOM_STRING
